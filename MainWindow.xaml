<Window x:Class="TemplateFor_Vosmerka.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Производство Каучука - Восьмерка"
        Icon="/Images/Восьмерка.ico"
        Height="450" Width="800"
        FontFamily="Courier New">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel DockPanel.Dock="Top" Background="{StaticResource ExtraBackground}" Orientation="Horizontal" Height="50">
            <Button x:Name="BtnBack" Content="Назад" Click="BtnBack_Click" Width="80" Margin="10"/>
            <Image Source="/Images/logo.png" Width="40" Margin="10,0"/>
            <TextBlock Text="Компания Восьмерка" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Width="250"/>

            <TextBlock x:Name="TxtUserFio" VerticalAlignment="Center" HorizontalAlignment="Right"
                       Margin="0,0,20,0" FontSize="14" FontWeight="Bold" Foreground="#A163F5"/>
        </StackPanel>
        <Frame Grid.Row="1" x:Name="MainFrame" NavigationUIVisibility="Hidden" ContentRendered="MainFrame_ContentRendered"/>
    </Grid>
</Window>
