<Page x:Class="TemplateFor_Vosmerka.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Авторизация">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
        <TextBlock Text="Авторизация" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        <TextBox x:Name="TbLogin" Margin="0,5" />
        <PasswordBox x:Name="PbPassword" Margin="0,5" />
        <Button x:Name="BtnLogin" Content="Войти" Style="{StaticResource AccentButton}" Click="BtnLogin_Click" Margin="0,10"/>
        <Button x:Name="BtnGuest" Content="Войти как гость" Click="BtnGuest_Click" Margin="0,5"/>
    </StackPanel>
</Page>
