<Page x:Class="TemplateFor_Vosmerka.Pages.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      Title="Каталог продукции">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Фильтры, Поиск, Сортировка -->
        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchTxtBx" Margin="5" Tag="Введите для поиска"/>
            <ComboBox x:Name="SortCmbBx" Grid.Column="1" Margin="5" SelectedIndex="0">
                <ComboBoxItem Content="Сортировка"/>
                <ComboBoxItem Content="По возрастанию цены"/>
                <ComboBoxItem Content="По убыванию цены"/>
            </ComboBox>
            <ComboBox x:Name="FiltrCmbBx" Grid.Column="2" Margin="5" SelectedIndex="0" DisplayMemberPath="ProductTypeName"/>
        </Grid>

        <!-- Список продукции -->
        <ListView x:Name="ProductsListView" Grid.Row="1" Margin="10" HorizontalContentAlignment="Stretch"
                  MouseDoubleClick="ProductsListView_MouseDoubleClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" BorderBrush="#D3D3D3" BorderThickness="1" Margin="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>

                            <!-- Картинка слева -->
                            <Image Grid.Column="0" Width="80" Height="80" Margin="5" Source="{Binding ImagePath}"/>

                            <!-- Информация в центре -->
                            <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                <TextBlock FontSize="16" FontWeight="Bold">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} | {1}">
                                            <Binding Path="ProductType.ProductTypeName"/>
                                            <Binding Path="ProductName"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Text="{Binding Article, StringFormat={}Артикул: {0}}" Margin="0,3"/>
                                <TextBlock Text="{Binding MaterialsList, StringFormat={}Материалы: {0}}" TextWrapping="Wrap" Foreground="Black"/>
                            </StackPanel>

                            <!-- Стоимость справа -->
                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Margin="10">
                                <TextBlock.Text>
                                    <Binding Path="MinCost" StringFormat="{}{0} руб."/>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>

            <!-- Подсветка строк с минимальной ценой > 10000 руб. цветом #BB5FCA -->
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExpensive}" Value="True">
                            <Setter Property="Background" Value="#BB5FCA"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <!-- Нижняя панель действий (только админ) -->
        <StackPanel x:Name="AdminPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button x:Name="BtnAdd" Content="Добавить продукцию" Margin="5" Width="180" Click="BtnAdd_Click"/>
            <Button x:Name="BtnEdit" Content="Изменить продукцию" Margin="5" Width="180" Click="BtnEdit_Click"/>
            <Button x:Name="BtnDelete" Content="Удалить продукцию" Margin="5" Width="180" Click="BtnDelete_Click"/>
        </StackPanel>

        <!-- Навигация по разделам (админ + менеджер) -->
        <Button x:Name="BtnMaterials" Grid.Row="3" Content="Перейти к материалам" Width="200"
                HorizontalAlignment="Center" Margin="0,0,0,10" Click="BtnMaterials_Click"/>
    </Grid>
</Page>
