<Page x:Class="TemplateFor_Vosmerka.Pages.AddEditProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Добавление/Редактирование продукции">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ID (только для чтения, виден только в режиме редактирования) -->
        <Grid x:Name="IdPanel" Grid.Row="0" Margin="0,0,0,10" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="ID продукции:" VerticalAlignment="Center"/>
            <TextBox x:Name="TbProductId" Grid.Column="1" IsReadOnly="True" Background="#F0F0F0"/>
        </Grid>

        <!-- Фото -->
        <Border Grid.Row="1" Width="300" Height="200" BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,5"
                HorizontalAlignment="Left">
            <Image x:Name="ImgPreview" Source="/Images/picture.png" Stretch="Uniform"/>
        </Border>
        <Button Grid.Row="2" Content="Загрузить фото" Click="BtnLoadImage_Click" Width="150" HorizontalAlignment="Left" Margin="0,0,0,10"/>

        <!-- Наименование -->
        <Grid Grid.Row="3" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Наименование:" VerticalAlignment="Center"/>
            <TextBox x:Name="TbProductName" Grid.Column="1"/>
        </Grid>

        <!-- Тип продукции -->
        <Grid Grid.Row="4" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Тип продукции:" VerticalAlignment="Center"/>
            <ComboBox x:Name="CbProductType" Grid.Column="1" DisplayMemberPath="ProductTypeName"/>
        </Grid>

        <!-- Артикул -->
        <Grid Grid.Row="5" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Артикул:" VerticalAlignment="Center"/>
            <TextBox x:Name="TbArticle" Grid.Column="1"/>
        </Grid>

        <!-- Стоимость -->
        <Grid Grid.Row="6" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Стоимость (руб.):" VerticalAlignment="Center"/>
            <TextBox x:Name="TbCost" Grid.Column="1"/>
        </Grid>

        <!-- Кол-во человек -->
        <Grid Grid.Row="7" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Кол-во человек:" VerticalAlignment="Center"/>
            <TextBox x:Name="TbHumanResourses" Grid.Column="1"/>
        </Grid>

        <!-- Номер цеха -->
        <Grid Grid.Row="8" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Номер цеха:" VerticalAlignment="Center"/>
            <ComboBox x:Name="CbProductPlace" Grid.Column="1" DisplayMemberPath="Number"/>
        </Grid>

        <!-- Кнопки -->
        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnSave" Content="Сохранить" Click="BtnSave_Click" Width="120" Margin="0,0,10,0" FontWeight="Bold"/>
            <Button Content="Отмена" Click="BtnCancel_Click" Width="120"/>
        </StackPanel>
    </Grid>
</Page>
