<Page x:Class="TemplateFor_Vosmerka.Pages.MaterialPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Склад материалов">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Фильтры, Поиск, Сортировка -->
        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchTxtBx" Margin="5" Tag="Введите для поиска"/>
            <ComboBox x:Name="SortCmbBx" Grid.Column="1" Margin="5" SelectedIndex="0">
                <ComboBoxItem Content="Сортировка"/>
                <ComboBoxItem Content="По возрастанию стоимости"/>
                <ComboBoxItem Content="По убыванию стоимости"/>
                <ComboBoxItem Content="По кол-ву на складе"/>
            </ComboBox>
            <ComboBox x:Name="FiltrCmbBx" Grid.Column="2" Margin="5" SelectedIndex="0" DisplayMemberPath="MaterialTypeName"/>
        </Grid>

        <!-- Список материалов -->
        <ListView x:Name="MaterialsListView" Grid.Row="1" Margin="10" HorizontalContentAlignment="Stretch"
                  MouseDoubleClick="MaterialsListView_MouseDoubleClick">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                            <Setter Property="Background" Value="#E0E0E0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" BorderBrush="#D3D3D3" BorderThickness="1" Margin="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding MaterialName}" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{Binding MaterialType.MaterialTypeName}" Foreground="Gray"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding QuantityInPac, StringFormat='В упаковке: {0} шт.'}"/>
                                <TextBlock Text="{Binding QuantityInHub, StringFormat='На складе: {0} шт.'}"/>
                                <TextBlock Text="{Binding MinQuantity, StringFormat='Мин. остаток: {0} шт.'}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding QuantityType.QuantityTypeName, StringFormat='Ед. изм.: {0}'}"/>
                                <TextBlock Text="{Binding Cost, StringFormat='Стоимость: {0:F2} руб.'}" FontWeight="Bold" FontSize="16"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Панель администрирования -->
        <StackPanel x:Name="AdminPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
            <Button x:Name="BtnAdd" Content="Добавить материал" Margin="5" Width="180" Click="BtnAdd_Click"/>
            <Button x:Name="BtnDelete" Content="Удалить материал" Margin="5" Width="180" Click="BtnDelete_Click"/>
        </StackPanel>

        <!-- Навигация -->
        <Button x:Name="BtnBackToProducts" Grid.Row="3" Content="Назад к продукции" Width="200"
                HorizontalAlignment="Center" Margin="5,5,5,10" Click="BtnBackToProducts_Click"/>
    </Grid>
</Page>
