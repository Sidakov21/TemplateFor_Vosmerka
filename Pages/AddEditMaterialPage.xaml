<Page x:Class="TemplateFor_Vosmerka.Pages.AddEditMaterialPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Добавление/Редактирование материала">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ID (только редактирование) -->
        <Grid x:Name="IdPanel" Grid.Row="0" Margin="0,0,0,10" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="ID материала:" VerticalAlignment="Center"/>
            <TextBox x:Name="TbMaterialId" Grid.Column="1" IsReadOnly="True" Background="#F0F0F0"/>
        </Grid>

        <!-- Наименование -->
        <Grid Grid.Row="1" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Наименование:" VerticalAlignment="Center"/>
            <TextBox x:Name="TbMaterialName" Grid.Column="1"/>
        </Grid>

        <!-- Тип материала -->
        <Grid Grid.Row="2" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Тип материала:" VerticalAlignment="Center"/>
            <ComboBox x:Name="CbMaterialType" Grid.Column="1" DisplayMemberPath="MaterialTypeName"/>
        </Grid>

        <!-- Количество в упаковке -->
        <Grid Grid.Row="3" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Кол-во в упаковке:" VerticalAlignment="Center"/>
            <TextBox x:Name="TbQuantityInPac" Grid.Column="1"/>
        </Grid>

        <!-- Единица измерения -->
        <Grid Grid.Row="4" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Единица измерения:" VerticalAlignment="Center"/>
            <ComboBox x:Name="CbQuantityType" Grid.Column="1" DisplayMemberPath="QuantityTypeName"/>
        </Grid>

        <!-- Количество на складе -->
        <Grid Grid.Row="5" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Кол-во на складе:" VerticalAlignment="Center"/>
            <TextBox x:Name="TbQuantityInHub" Grid.Column="1"/>
        </Grid>

        <!-- Минимальный остаток -->
        <Grid Grid.Row="6" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Мин. остаток:" VerticalAlignment="Center"/>
            <TextBox x:Name="TbMinQuantity" Grid.Column="1"/>
        </Grid>

        <!-- Стоимость -->
        <Grid Grid.Row="7" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Стоимость:" VerticalAlignment="Center"/>
            <TextBox x:Name="TbCost" Grid.Column="1"/>
        </Grid>

        <!-- Кнопки -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnSave" Content="Сохранить" Click="BtnSave_Click" Width="120" Margin="0,0,10,0" FontWeight="Bold"/>
            <Button Content="Отмена" Click="BtnCancel_Click" Width="120"/>
        </StackPanel>
    </Grid>
</Page>
